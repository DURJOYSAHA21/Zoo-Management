<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.config (same folder) and fill it in. secrets.config is git-ignored,
  so the password never reaches GitHub. Create an app password at
  https://myaccount.google.com/apppasswords (needs 2-Step Verification on the Gmail account).
-->
<appSettings>
  <add key="SmtpUser" value="your.address@gmail.com" />
  <add key="SmtpPassword" value="your 16-letter app password" />
</appSettings>
