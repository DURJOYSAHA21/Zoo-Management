<?xml version="1.0" encoding="utf-8"?>
<!--
  EMAIL SETUP FOR OTP CODES

  The app sends OTP codes by email for sign-up, password reset and payments.
  It sends them from YOUR Gmail account, so you need to add your own address and an app password.
  Without this file the app still runs, but any screen that sends an OTP shows
  "Email is not set up".

  Steps:
  1. Turn on 2-Step Verification for your Google account:
     https://myaccount.google.com/signinoptions/twosv
  2. Create an app password (name it e.g. "Zoo Management"):
     https://myaccount.google.com/apppasswords
     Google shows a 16-letter code once. Copy it.
  3. Copy this file in the same folder and name the copy  secrets.config
     (Zoo Management System\secrets.config, next to App.config).
  4. In secrets.config, replace the two values below with your Gmail address and the 16-letter code.
     Spaces in the code are fine.
  5. Rebuild and run. The build copies secrets.config next to ZooManagementSystem.exe.

  Keep it private:
  - secrets.config is listed in .gitignore, so git will not upload it. Never rename or commit it
    under another name.
  - Use an app password, never your normal Gmail password.
  - If the code ever leaks, delete it at https://myaccount.google.com/apppasswords and make a new one.
-->
<appSettings>
  <add key="SmtpUser" value="your.address@gmail.com" />
  <add key="SmtpPassword" value="abcd efgh ijkl mnop" />
</appSettings>
